    "line": {
      "DEFAULT": "#E8EAED",
      "2": "#F1F2F4",
      "3": "#EFF1F3"
    },
    "bg": "#FFFFFF",
    "surface": "#FAFAFB",
    "surface-2": "#F7F8FA"
  },
  "fontFamily": {
    "sans": ["Inter", "-apple-system", "Segoe UI", "system-ui", "sans-serif"]
  },
  "fontFeatureSettings": "\"ss01\", \"cv11\"",
  "borderRadius": {
    "btn": "14px",
    "card": "16px",
    "chip": "999px",
    "hero": "22px",
    "frame-mobile": "44px"
  },
  "boxShadow": {
    "primary": "0 1px 0 rgba(0,0,0,0.04), 0 2px 8px rgba(55,138,221,0.18)",
    "card": "0 6px 20px rgba(20,25,30,0.06)",
    "device": "0 28px 60px rgba(20,25,30,0.12), 0 0 0 1px rgba(20,25,30,0.08)",
    "hero": "0 20px 50px rgba(0,0,0,0.18)"
  },
  "fontSize": {
    "display":      ["64px", { "lineHeight": "1",     "letterSpacing": "-2.5px", "fontWeight": "700" }],
    "display-sm":   ["44px", { "lineHeight": "1",     "letterSpacing": "-1.6px", "fontWeight": "700" }],
    "h1":           ["30px", { "lineHeight": "1.15",  "letterSpacing": "-0.6px", "fontWeight": "700" }],
    "h2":           ["24px", { "lineHeight": "1.2",   "letterSpacing": "-0.5px", "fontWeight": "700" }],
    "h3":           ["18px", { "lineHeight": "1.3",   "letterSpacing": "-0.2px", "fontWeight": "700" }],
    "card-title":   ["16px", { "lineHeight": "1.35",  "letterSpacing": "-0.2px", "fontWeight": "600" }],
    "body":         ["15px", { "lineHeight": "1.45",  "fontWeight": "500" }],
    "meta":         ["13px", { "lineHeight": "1.4",   "fontWeight": "500" }],
    "eyebrow":      ["12px", { "lineHeight": "1.2",   "letterSpacing": "0.4px", "fontWeight": "600", "textTransform": "uppercase" }],
    "tab":          ["11px", { "lineHeight": "1",     "fontWeight": "600" }]
  },
  "componentSizing": {
    "primaryButton": { "height": "56px",  "radius": "14px", "fontSize": "17px", "fontWeight": "600" },
    "secondaryButton": { "height": "52px","radius": "14px", "fontSize": "16px", "fontWeight": "500" },
    "input":         { "height": "52-56px","radius": "12-14px", "fontSize": "16px" },
    "searchField":   { "height": "48px",  "radius": "12px" },
    "tabBar":        { "height": "84px",  "safeArea": "22px" },
    "sidebar":       { "width":  "230px", "padding": "22px 14px" },
    "avatar":        { "sizes": [32, 36, 38, 40, 44, 48] },
    "viewport":      { "mobile": "390x844", "desktopMaxWidth": "1100px" }
  },
  "iconography": {
    "library": "lucide-react",
    "stroke": "1.75",
    "lineCap": "round",
    "lineJoin": "round",
    "used": ["plus", "check", "search", "back/chevron-left", "chevron-right",
             "user", "users", "wallet", "cash/banknote", "list",
             "package/box", "more-horizontal", "download", "printer",
             "store", "calendar", "filter", "bell", "x", "edit-3"]
  }
}
