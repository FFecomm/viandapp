    },
    "yellow": {
      "DEFAULT": "#FAEEDA",
      "ink": "#8A6A1F",
      "border": "#F0E0BB",
      "pill-bg": "#F4DDA5",
      "pill-ink": "#7A5A14"
    },
    "red": {
      "DEFAULT": "#FCEBEB",
      "ink": "#C0392B",
      "border": "#F2C9C9"
    },
    "violet": {
      "DEFAULT": "#534AB7",
      "50": "#ECEAF8",
      "ink": "#3A3380"
