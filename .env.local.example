# Copiar a .env.local y completar con los valores de tu proyecto de Supabase.
# Encontralos en https://supabase.com/dashboard/project/<id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx

# Necesaria SOLO para que el Administrativo pueda crear/eliminar usuarios desde la app.
# Nunca exponerla con prefijo NEXT_PUBLIC_; sólo se usa server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx
