# Copiar a .env.local y completar con los valores reales.

# ----- Supabase -----
# https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Mercado Pago -----
# https://www.mercadopago.com.ar/developers/panel/app/<id>/credentials
# Producción: empieza con APP_USR-...
# Sandbox: empieza con TEST-...
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Secret del webhook (mercadopago.com.ar/developers/panel/app/<id>/webhooks → "Secret key").
# Si está vacío, no se valida la firma (solo dev). EN PRODUCCIÓN ES OBLIGATORIO.
MP_WEBHOOK_SECRET=
# Comisión fija en pesos por vianda que se queda con la plataforma (Felipe)
COMISION_POR_VIANDA=400

# ----- App -----
# URL pública del deploy o de localhost para los back_urls de MP
NEXT_PUBLIC_BASE_URL=http://localhost:3000
